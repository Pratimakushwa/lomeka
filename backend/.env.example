PORT=5000
HOST=127.0.0.1
NODE_ENV=production

# Public site origin(s) for CORS + cookie-safe admin login (comma-separated)
FRONTEND_URL=https://your-domain.com

# MongoDB Atlas connection string (recommended on 4GB KVM)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/lomeka

# Used only once to create the first superadmin if DB has no admins
ADMIN_EMAIL=owner@your-domain.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-plus-char-random-secret
